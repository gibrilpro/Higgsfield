# Adresse publique du site (sans / final)
APP_URL=http://localhost:3000

# Base de données : fichier local en développement, Turso en production
DATABASE_URL=file:./data/delegue.db
DATABASE_AUTH_TOKEN=

# E-mail du compte administrateur (validation des experts, litiges)
ADMIN_EMAIL=contact.novashop21@gmail.com

# Diagnostic IA (facultatif : sans clé, le site utilise des modèles de solutions)
ANTHROPIC_API_KEY=

# Paiements Stripe (facultatif : sans clé, le site fonctionne en mode démo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Commission de la plateforme, en pourcentage
COMMISSION_PERCENT=15
